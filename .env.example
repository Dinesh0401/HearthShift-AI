# ==============================================================================
# HearthShift AI — Optional Build & Runtime Configuration (.env.example)
# ==============================================================================
#
# ARCHITECTURAL PRIVACY NOTICE (ZERO SECRETS / ZERO BACKEND):
# HearthShift AI executes 100% client-side inside the user's web browser using
# pure JavaScript/TypeScript and local browser IndexedDB ("HearthShiftDB").
#
# There are ZERO secret keys, API keys, database connection strings, OAuth
# credentials, analytics tokens, or remote backend URLs in this application.
# Never add secret server-side tokens or third-party telemetry keys here.
#
# Copy to `.env.local` only if you want to override local build/runtime flags
# (`.env*.local` is gitignored).
# ==============================================================================

# Optional non-secret environment label for operator/build identification
# Allowed values: development | staging | production
NEXT_PUBLIC_APP_ENV=production

# Optional build-time telemetry opt-out for Next.js CLI (automatically enabled in `npm run build:static`)
NEXT_TELEMETRY_DISABLED=1

# Optional static export toggle consumed by `next.config.mjs`
# - Set to `true` to generate a static bundle (`output: 'export'` -> `out/`)
#   for CDN/object hosting (Cloudflare Pages, Netlify, static S3/Nginx) paired
#   with `public/_headers` or `vercel.json`.
# - Leave `false` or unset for standard Node.js runtime (`npm run start`) where
#   `next.config.mjs` serves strict HTTP security headers dynamically.
NEXT_STATIC_EXPORT=false

# Optional build/runtime visibility flag for the client-side Synthetic Demo Mode
# (`src/core/demo/synthetic-household.ts` — loads 3 synthetic bills + 192h
# simulated intervals locally into IndexedDB with zero fake verified savings).
# Allowed values: true | false
NEXT_PUBLIC_DEMO_ENABLED=true

# Optional HTTP listening port for Node.js production server (`npm run start`)
# Bind strictly behind a TLS/HTTPS reverse proxy on 127.0.0.1 in production.
# Default: 3000 (Playwright E2E tests use port 3008 via `playwright.config.ts`).
PORT=3000
